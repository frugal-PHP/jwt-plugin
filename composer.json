{
    "name": "frugal-php/jwt-plugin",
    "description": "Gestion des connexions avec jwt",
    "require": {
        "firebase/php-jwt": "^6.11",
        "frugal-php/core": "dev-main",
        "frugal-php/orm": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "FrugalPhpPlugin\\Jwt\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Grégory COLLIN",
            "email": "gregory@badass-coding.com"
        }
    ],
    "require-dev": {
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ],
            "recurse": true,
            "replace": false,
            "merge-dev": true
        }
    },
    "config": {
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    }
}
